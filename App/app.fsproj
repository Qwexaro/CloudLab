<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ModelsData/Todo.fs" />
    <Compile Include="ModelsData/CreateTodoRequest.fs" />
    <Compile Include="PrometheusMetrix/RequestCounter.fs" />
    <Compile Include="Config/ConfigDataBase.fs" />
    <Compile Include="Handlers/Todos.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Falco" Version="5.2.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

</Project>
